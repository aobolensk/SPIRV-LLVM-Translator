; Covers the 1-component OpTypeVector the extension permits.

; RUN: llvm-spirv %s -to-binary -o %t.spv
; RUN: spirv-val %t.spv
; RUN: llvm-spirv %t.spv -to-text -o - | FileCheck %s --check-prefix=CHECK-SPIRV
; RUN: llvm-spirv -r %t.spv --spirv-ext=+SPV_EXT_long_vector -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc -o - | FileCheck %s --check-prefix=CHECK-LLVM

; Reverse translation allows every known extension by default.
; RUN: not llvm-spirv -r %t.spv --spirv-ext=-SPV_EXT_long_vector -o %t.no-ext.bc 2>&1 | FileCheck %s --check-prefix=CHECK-NO-EXT

; CHECK-SPIRV-DAG: Capability LongVectorEXT
; CHECK-SPIRV-DAG: Extension "SPV_EXT_long_vector"
; CHECK-SPIRV-DAG: TypeInt [[#I32:]] 32 0
; CHECK-SPIRV-DAG: Constant [[#I32]] [[#SIX:]] 6
; CHECK-SPIRV-DAG: Constant [[#I32]] [[#SEVEN:]] 7
; CHECK-SPIRV-DAG: TypeVectorIdEXT [[#]] [[#I32]] [[#SIX]]
; CHECK-SPIRV-DAG: TypeVectorIdEXT [[#]] [[#I32]] [[#SEVEN]]
; CHECK-SPIRV-DAG: TypeVector [[#]] [[#I32]] 1

; CHECK-NO-EXT: input SPIR-V module uses extension 'SPV_EXT_long_vector' which were disabled by --spirv-ext option

; CHECK-LLVM-LABEL: define spir_kernel void @foo(
; CHECK-LLVM-SAME: ptr addrspace(1) %[[#P6:]], ptr addrspace(1) %[[#P7:]], ptr addrspace(1) %[[#P1:]])
; CHECK-LLVM: %[[#V6:]] = load <6 x i32>, ptr addrspace(1) %[[#P6]]
; CHECK-LLVM: %[[#A6:]] = add <6 x i32> %[[#V6]], <i32 1, i32 2, i32 3, i32 4, i32 5, i32 6>
; CHECK-LLVM: store <6 x i32> %[[#A6]], ptr addrspace(1) %[[#P6]]
; CHECK-LLVM: %[[#V7:]] = load <7 x i32>, ptr addrspace(1) %[[#P7]]
; CHECK-LLVM: %[[#E7:]] = extractelement <7 x i32> %[[#V7]], i32 6
; CHECK-LLVM: %[[#V1:]] = load <1 x i32>, ptr addrspace(1) %[[#P1]]
; CHECK-LLVM: %[[#A1:]] = add <1 x i32> %[[#V1]], %[[#V1]]
; CHECK-LLVM: store <1 x i32> %[[#A1]], ptr addrspace(1) %[[#P1]]
; CHECK-LLVM: store <6 x i32> <i32 6, i32 5, i32 4, i32 3, i32 2, i32 1>, ptr addrspace(1) %[[#P6]]
; CHECK-LLVM: store <1 x i32> splat (i32 1), ptr addrspace(1) %[[#P1]]

119734787 66304 393230 40 0
2 Capability Addresses
2 Capability Kernel
2 Capability LongVectorEXT
6 Extension "SPV_EXT_long_vector"
5 ExtInstImport 1 "OpenCL.std"
3 MemoryModel 2 2
